# Server
PORT=4000
# Public-facing URL (no trailing slash), used for absolute OG image URLs in embeds
# Example: https://dovedalegeoguesser.com
# Setting it (or NODE_ENV=production) also marks cookies Secure and turns on HSTS, so use it whenever the site is on HTTPS
SITE_URL=

# Discord OAuth: create an app at https://discord.com/developers/applications
# Scopes required: identify
# Redirect URI must match exactly what you register in the Discord app's OAuth2 settings
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/callback

# Comma-separated Discord user IDs of the operators, who run the site
# Every other staff role is given from the staff panel
OPERATOR_IDS=

# Set to true to bypass Discord OAuth and log in as a local dev account
# Never enable this in production
AUTH_DEV=false

# Optional: where the database and uploaded screenshots are stored
# Defaults to ./data and ./public/uploads
DATA_DIR=
UPLOADS_DIR=

# Emailed notification summaries are set up from the staff panel (Email tab), not here

# Optional: Discord webhook URL for notifications
DISCORD_WEBHOOK_URL=
# Comma-separated event categories to fire, or "all" (default)
# Available: submissions, suggestions, locations, users, bans (all moderation), duels, support,
# system (server start, errors, failed backups, announcements)
WEBHOOK_EVENTS=all

# Optional: operators can install updates and restart from the staff panel (System tab).
# The server only ever fast-forwards to UPDATE_BRANCH on its own "origin" remote.
# Set PANEL_UPDATES=off to remove the feature.
PANEL_UPDATES=on
UPDATE_BRANCH=main

# Optional: Web Push, so notifications can reach players when the site is closed.
# Generate a pair with: bun run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URL or mailto: address that push services can use to reach you
VAPID_SUBJECT=
