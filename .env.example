# Server
PORT=4000
# Public-facing URL (no trailing slash) - used for absolute OG image URLs in embeds
# Example: https://dovedalegeoguesser.com
SITE_URL=

# Discord OAuth - create an app at https://discord.com/developers/applications
# Scopes required: identify
# Redirect URI must match exactly what you register in the Discord app's OAuth2 settings
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/callback

# Comma-separated Discord user IDs granted elevated roles
# Operators can do everything moderators can, plus permanent bans and site blocks
OPERATOR_IDS=
MODERATOR_IDS=

# Set to true to bypass Discord OAuth and log in as a local dev account
# Never enable this in production
AUTH_DEV=false

# Optional: Discord webhook URL for notifications
DISCORD_WEBHOOK_URL=
# Comma-separated event categories to fire, or "all" (default)
# Available: submissions, suggestions, users, bans, duels, support
WEBHOOK_EVENTS=all
