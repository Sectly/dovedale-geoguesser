{
	"name": "dovedale-geoguesser",
	"repository": "https://github.com/Sectly/dovedale-geoguesser",
	"scripts": {
		"start": "bun run server.ts",
		"dev": "bun run --watch server.ts",
		"build": "bun run scripts/build.ts",
		"build:css": "bun run scripts/build.ts --no-format",
		"test": "bun test --isolate",
		"typecheck": "tsc --noEmit",
		"seed": "bun run scripts/seed-dev.ts",
		"vapid": "bun run scripts/generate-vapid.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"maintenance": "bun --hot dev-maintenance.ts",
		"sync-map": "bun run scripts/sync-map.ts",
		"tiles": "bun run scripts/build-tiles.ts"
	},
	"dependencies": {
		"@webwirejs/client": "^0.1.0",
		"@webwirejs/hono": "^0.1.0",
		"@webwirejs/server": "^0.1.0",
		"hono": "^4.11.0",
		"nodemailer": "^10.1.0",
		"sharp": "^0.35.5",
		"web-push": "^3.6.7"
	},
	"devDependencies": {
		"@types/bun": "^1.3.4",
		"@types/nodemailer": "^8.0.2",
		"@types/web-push": "^3.6.4",
		"prettier": "^3.4.2",
		"tailwindcss": "3.4.17",
		"typescript": "^7.0.2"
	}
}
